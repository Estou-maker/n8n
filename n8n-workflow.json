{
  "name": "Daily YouTube Kids Video Generator (Native Nodes)",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 6,
              "minute": 0
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Daily at 6 AM",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "prompt": "Create a 3-minute nursery rhyme video for YouTube Kids (ages 2-5).\n\nOutput ONLY valid JSON with this exact structure:\n{\n  \"title\": \"string - catchy, kid-friendly, < 60 chars\",\n  \"description\": \"string - 2-3 sentences, includes keywords\",\n  \"tags\": [\"string\", \"...\"],\n  \"playlist\": \"string - playlist name or ID\",\n  \"scenes\": [\n    {\n      \"id\": 1,\n      \"duration\": 12,\n      \"prompt\": \"string - detailed SDXL prompt for this scene: character + setting + mood + style. Consistent character description. 2D nursery rhyme illustration style, bright colors, simple shapes.\",\n      \"lyrics\": \"string - 1-2 lines of lyrics shown on screen during this scene\",\n      \"narration\": \"string - voiceover text for this scene (spoken, not sung)\"\n    }\n    // ... 12-15 scenes total, durations sum to ~180 seconds\n  ],\n  \"backgroundMusic\": \"string - mood/tempo for CC0 music search (e.g. 'cheerful acoustic ukulele 80bpm')\"\n}\n\nRequirements:\n- Main character: A friendly animated bunny named \"Benny\" - round, soft, big ears, blue shirt, always smiling\n- Educational theme: colors, numbers, animals, or daily routines\n- Simple repetitive lyrics kids can sing along\n- Gentle, soothing tone\n- Each scene 10-15 seconds\n- Total ~180 seconds (3 minutes)\n- Scene prompts must include: \"Benny the bunny, round soft blue shirt, big ears, 2D vector illustration, nursery rhyme style, bright pastel colors, simple shapes, clean lines\"\n- Lyrics timed to match scene duration\n- Narration separate from lyrics (spoken storyteller voice)",
        "options": {
          "temperature": 0.8,
          "maxOutputTokens": 4096
        }
      },
      "id": "generate-script",
      "name": "Generate Script (Gemini)",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "googleGeminiApi": "gemini-api"
      }
    },
    {
      "parameters": {
        "functionCode": "// Parse Gemini response and extract JSON\nconst response = $input.item.json;\nlet text = response.text || response.content || JSON.stringify(response);\ntext = text.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(text);\n\nreturn [{ json: parsed }];"
      },
      "id": "parse-script",
      "name": "Parse Script JSON",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "options": {},
        "url": "https://image.pollinations.ai/prompt/{{ encodeURIComponent($json.CHARACTER_PROMPT + ', ' + $json.item.prompt) }}?width=1920&height=1080&seed={{ 12345 + $json.item.id }}&model=flux&nologo=true",
        "method": "GET",
        "responseFormat": "file",
        "jsonParameters": false
      },
      "id": "generate-images",
      "name": "Generate Scene Images (Pollinations)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "url": "https://edge.microsoft.com/translate/tts",
        "method": "POST",
        "options": {},
        "jsonParameters": false,
        "headerParametersJson": "Content-Type: application/x-www-form-urlencoded",
        "bodyParametersJson": "text={{ $json.ssml }}&voice=en-US-JennyNeural",
        "responseFormat": "file"
      },
      "id": "generate-voiceover",
      "name": "Generate Voiceover (Edge TTS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/Estou-maker/n8n/actions/workflows/render-video.yml/dispatches",
        "method": "POST",
        "options": {},
        "jsonParameters": true,
        "headerParametersJson": "Authorization: Bearer YOUR_GH_TOKEN\nAccept: application/vnd.github.v3+json",
        "bodyParametersJson": "{\n  \"ref\": \"main\",\n  \"inputs\": {\n    \"script\": \"{{ JSON.stringify($json) }}\"\n  }\n}"
      },
      "id": "trigger-render",
      "name": "Trigger GitHub Actions Render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1500, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "fileProperty": "data",
        "fileName": "kids_video_{{ $now.format('YYYYMMDD') }}.mp4",
        "folderId": "YOUR_DRIVE_FOLDER_ID",
        "options": {}
      },
      "id": "upload-drive",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1750, 300],
      "credentials": {
        "googleDriveOAuth2Api": "google-drive-oauth"
      }
    }
  ],
  "connections": {
    "Daily at 6 AM": {
      "main": [
        [
          {
            "node": "Generate Script (Gemini)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Script (Gemini)": {
      "main": [
        [
          {
            "node": "Parse Script JSON",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Script JSON": {
      "main": [
        [
          {
            "node": "Generate Scene Images (Pollinations)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Scene Images (Pollinations)": {
      "main": [
        [
          {
            "node": "Generate Voiceover (Edge TTS)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Voiceover (Edge TTS)": {
      "main": [
        [
          {
            "node": "Trigger GitHub Actions Render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger GitHub Actions Render": {
      "main": [
        [
          {
            "node": "Upload to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "id": "1"
}